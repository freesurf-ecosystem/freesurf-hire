{
  "name": "freesurf-hire-web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "node -e \"const fs = require('fs'); const path = require('path'); ['out', '.next', 'node_modules/.cache'].forEach(dir => { const p = path.join('.', dir); if(fs.existsSync(p)) fs.rmSync(p, {recursive: true}); });\"",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "sitemaps:generate": "node scripts/sitemaps/generate-service-sitemaps.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/supabase-js": "^2.53.0",
    "lucide-react": "^0.460.0",
    "next": "^15.5.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.44.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "wrangler": "^4.132.0"
  }
}
